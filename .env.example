# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The database the app and the plain db:* scripts use. Locally this is the
# Docker Postgres from docker-compose.yml -- note port 5433, not 5432, so it
# does not collide with a Homebrew Postgres you may already be running.
DATABASE_URL="postgres://shortfuse:shortfuse@localhost:5433/shortfuse"

# Production database (Neon). Use the POOLED connection string -- the one whose
# host contains "-pooler". The db client picks Neon's serverless driver
# automatically from the hostname; nothing else in the app changes.
#
# This is NOT read by the app. It is only used by the :neon script variants:
#
#   pnpm db:migrate:neon      pnpm db:seed:neon
#   pnpm catalog:import:neon  pnpm db:studio:neon
#
# Keeping it separate from DATABASE_URL means production is only ever touched
# when you deliberately type ":neon". On Vercel there is no NEON_DATABASE_URL:
# set DATABASE_URL itself to the pooled string there.
NEON_DATABASE_URL=""

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonical URLs, Open Graph
# tags, the sitemap, and Stripe success/cancel redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Admin authentication (single administrator)
# ---------------------------------------------------------------------------
# Generate with:  pnpm admin:password 'your-password-here'
ADMIN_PASSWORD_HASH=""
# 32+ random chars. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---------------------------------------------------------------------------
# Image storage
# ---------------------------------------------------------------------------
# Vercel Blob read/write token. Leave empty to have the importer mirror images
# to apps/web/public/media/ on local disk instead.
BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# Transactional email (Resend)
# ---------------------------------------------------------------------------
# Sends the order confirmation and the shipping notice. Leave RESEND_API_KEY
# empty and no mail is sent -- orders still work, and admin shows the email
# as "not sent" with a button to try again.
RESEND_API_KEY=""
# Must be on a domain verified in Resend. Until shortfusemusic.com is verified,
# "Short Fuse <onboarding@resend.dev>" works but only delivers to the Resend
# account owner's own address.
EMAIL_FROM="Short Fuse <onboarding@resend.dev>"
# Where customer replies go. Falls back to the From address if unset.
EMAIL_REPLY_TO=""
