# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development (matches docker-compose.yml -- note port 5433, not 5432,
# so it does not collide with a Homebrew Postgres you may already be running):
DATABASE_URL="postgres://shortfuse:shortfuse@localhost:5433/shortfuse"
#
# Production: the POOLED Neon connection string (the one containing "-pooler").
# DATABASE_URL="postgres://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/shortfuse?sslmode=require"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonical URLs, Open Graph
# tags, the sitemap, and Stripe success/cancel redirects.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Admin authentication (single administrator)
# ---------------------------------------------------------------------------
# Generate with:  pnpm admin:password 'your-password-here'
ADMIN_PASSWORD_HASH=""
# 32+ random chars. Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=""

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_..."
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---------------------------------------------------------------------------
# Image storage
# ---------------------------------------------------------------------------
# Vercel Blob read/write token. Leave empty to have the importer mirror images
# to apps/web/public/media/ on local disk instead.
BLOB_READ_WRITE_TOKEN=""
